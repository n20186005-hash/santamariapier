---
import type { Lang } from '../i18n/utils';
import { rebuild } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');
---
<section id="rebuild" class="bg-[color:var(--color-mist)] py-20 md:py-24 border-y border-black/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-4xl">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">{_(rebuild.sectionNum)}</div>
      <h2 class="font-display text-3xl md:text-5xl mt-4 leading-tight" set:html={_(rebuild.heading)} />
      <p class="mt-6 text-[color:var(--color-moss)]/80 leading-relaxed" set:html={_(rebuild.lede)} />
    </div>

    <div class="mt-12 grid lg:grid-cols-3 gap-6">
      {rebuild.blocks.map((b) => (
        <article class="rounded-3xl bg-white border border-black/5 p-7">
          <div class="text-xs uppercase tracking-widest text-[color:var(--color-emerald)]">{_(b.kicker)}</div>
          <h3 class="font-display text-2xl mt-3 leading-tight" set:html={_(b.title)} />
          <div class="mt-4 text-sm leading-relaxed text-[color:var(--color-moss)]/85" set:html={_(b.body)} />
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-3xl bg-white/70 border border-black/5 p-7 max-w-4xl">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-emerald)]">{_(rebuild.tipLabel)}</div>
      <ul class="mt-3 space-y-2 text-sm text-[color:var(--color-moss)]/85">
        {rebuild.tips.map((t) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[color:var(--color-emerald)] shrink-0"></span>
            <span set:html={_(t)} />
          </li>
        ))}
      </ul>
    </div>

    {rebuild.sources && rebuild.sources.length > 0 && (
      <div class="mt-6 rounded-3xl bg-white/70 border border-black/5 p-7 max-w-4xl">
        <div class="text-xs uppercase tracking-widest text-[color:var(--color-emerald)]">{_(rebuild.sourcesLabel)}</div>
        <ul class="mt-3 space-y-3 text-sm text-[color:var(--color-moss)]/85">
          {rebuild.sources.map((s) => (
            <li class="flex flex-col gap-1">
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-black/20 hover:decoration-black/40">
                {_(s.label)}
              </a>
              <div>{_(s.note)}</div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
